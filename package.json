{
  "name": "oofetch",
  "type": "module",
  "version": "2.0.0-beta.2",
  "packageManager": "pnpm@10.15.0",
  "description": "A better ofetch.",
  "license": "MIT",
  "repository": "err-require-esm/oofetch",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pkgroll",
    "bump": "bumpp",
    "dev": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "play": "jiti playground/index.ts",
    "prepack": "pnpm build",
    "test": "pnpm lint && vitest run --coverage"
  },
  "dependencies": {
    "destr": "^2.0.5",
    "ufo": "^1.6.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.3.0",
    "@moeru/eslint-config": "0.1.0-beta.10",
    "@moeru/tsconfig": "0.1.0-beta.10",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "bumpp": "^10.2.3",
    "eslint": "^9.34.0",
    "h3": "^1.15.4",
    "jiti": "^2.5.1",
    "listhen": "^1.9.0",
    "pkgroll": "^2.15.4",
    "typescript": "^5.9.2",
    "undici": "^7.15.0",
    "vitest": "^3.2.4"
  }
}
