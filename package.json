{
  "name": "oofetch",
  "type": "module",
  "version": "1.4.1",
  "packageManager": "pnpm@10.15.0",
  "description": "A better ofetch.",
  "license": "MIT",
  "repository": "err-require-esm/oofetch",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "react-native": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "vitest",
    "lint": "eslint . && prettier -c src test playground examples",
    "lint:fix": "eslint --fix . && prettier -w src test playground examples",
    "play": "jiti playground/index.ts",
    "prepack": "pnpm build",
    "release": "pnpm test && changelogen --release && npm publish && git push --follow-tags",
    "test": "pnpm lint && vitest run --coverage"
  },
  "dependencies": {
    "destr": "^2.0.5",
    "ufo": "^1.6.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.3.0",
    "@moeru/eslint-config": "0.1.0-beta.10",
    "@moeru/tsconfig": "0.1.0-beta.10",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "h3": "^1.15.4",
    "jiti": "^2.5.1",
    "listhen": "^1.9.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "unbuild": "^3.6.1",
    "undici": "^7.15.0",
    "vitest": "^3.2.4"
  }
}
